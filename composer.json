{
  "name": "sugarcommerce/data-subject",
  "version": "1.1.0",
  "description": "The small, easily-botched pieces of answering a GDPR access or erasure request: the export without the columns a person must not be handed, finding an address in stored payloads however JSON escaped it, an audit trail that does not undo the erasure it records, and plain summaries of what was done. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/data-subject",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["gdpr", "privacy", "erasure", "subject-access", "right-to-be-forgotten", "data-protection"],
  "require": {
    "php": ">=8.5"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\DataSubject\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\DataSubject\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/data-subject/issues", "source": "https://github.com/sugarcommerce/data-subject" }
}
